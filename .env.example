# Base URL of the main 1lev1 app that owns /api/send (GraphQL gateway to Strapi).
# Our proxy forwards requests here, passing through the SSO cookies.
# Eventually this and Strapi share a host and talk internally.
MAIN_APP_URL=https://www.1lev1.com

# Optional shared secret sent as `x-consensus-secret` on proxied requests.
# When set, the main server should require it before honoring the service-token
# (isSer) path for consensus operations. Leave unset until the main server checks it.
PROXY_SHARED_SECRET=

# Optional Groq API key for AI placement suggestions/comments (/api/analyze).
# When unset, the discussion works without AI (it degrades gracefully).
GROQ_API_KEY=

# Base URL of the shared Strapi, used only for the public `cuntries` (places)
# query in /api/places. When unset, the places list is empty.
STRAPI_URL=https://api.1lev1.com
