# Base URL of the main 1lev1 app's API, which owns /api/send (the qids gateway).
# api.1lev1.com runs the main repo on the same server as Strapi, so calls go
# there rather than through www (which would forward to api — a double hop).
# Every backend call from this site goes through it; never to Strapi directly.
MAIN_APP_URL=https://api.1lev1.com

# Shared secret sent as `x-consensus-secret` on proxied requests. The main server
# honours the service-token (isSer) path for consensus qids only with it, so
# charter/guest visitors and the places list need it. Must equal the main app's
# CONSENSUS_PROXY_SECRET.
PROXY_SHARED_SECRET=

# Optional Groq API key for AI placement suggestions/comments (/api/analyze).
# When unset, the discussion works without AI (it degrades gracefully).
GROQ_API_KEY=

# Optional Groq chat model override (default: openai/gpt-oss-120b).
GROQ_MODEL=
